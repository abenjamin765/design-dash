{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Design Dash Workshop Activity Spec",
  "description": "Declarative spec for a Workshop elicitation activity (ADR-0004). Specs are data, not code: agents author them referencing Dash Model node ids; the runtime renders them and normalizes responses into model records. One activity per file at dashes/{slug}/workshop/{activity-id}.json.",
  "type": "object",
  "required": ["id", "type", "title", "phase", "prompt", "nodes", "normalizes_to", "payload"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Kebab-case activity id; filename is this id + .json."
    },
    "type": {
      "enum": ["question", "artifact_panel", "compare"],
      "description": "MVP primitive. Deck, Board, and Walkthrough follow demand (ADR-0004); extending the catalog is a versioned change."
    },
    "title": { "type": "string", "minLength": 1 },
    "phase": {
      "type": "string",
      "pattern": "^P[0-8]$",
      "description": "Dash phase this activity serves (P0–P8)."
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "description": "The exact question or instruction shown to the participant; also heads the markdown fallback worksheet."
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/node_id" },
      "description": "Dash Model node ids this activity elicits about."
    },
    "normalizes_to": {
      "enum": ["decision", "evidence", "annotation"],
      "description": "Model record type responses normalize into. Defaults per primitive are defined in the skill's normalization table; this field overrides the default."
    },
    "payload": {
      "type": "object",
      "description": "Primitive-specific configuration — see per-type conditionals."
    }
  },
  "definitions": {
    "node_id": {
      "type": "string",
      "pattern": "^(object|attribute|cta|role|dash|decision|evidence|assumption|insight|opportunity|requirement|constraint|scenario|flow|screen|outcome|annotation)-[a-z0-9-]+$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "question" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["mode"],
            "additionalProperties": false,
            "properties": {
              "mode": { "enum": ["single", "multi", "ranked", "scale", "free_text"] },
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["label", "value"],
                  "additionalProperties": false,
                  "properties": {
                    "label": { "type": "string", "minLength": 1 },
                    "value": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "scale": {
                "type": "object",
                "required": ["min", "max", "step"],
                "additionalProperties": false,
                "properties": {
                  "min": { "type": "number" },
                  "max": { "type": "number" },
                  "step": { "type": "number", "exclusiveMinimum": 0 }
                }
              }
            },
            "allOf": [
              {
                "if": { "properties": { "mode": { "enum": ["single", "multi", "ranked"] } }, "required": ["mode"] },
                "then": { "required": ["mode", "options"] }
              },
              {
                "if": { "properties": { "mode": { "const": "scale" } }, "required": ["mode"] },
                "then": { "required": ["mode", "scale"] }
              }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "artifact_panel" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["target_node_id", "render", "annotations_enabled"],
            "additionalProperties": false,
            "properties": {
              "target_node_id": { "$ref": "#/definitions/node_id" },
              "render": { "enum": ["wireframe", "object_card", "spec_excerpt", "image"] },
              "annotations_enabled": { "type": "boolean" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "compare" } }, "required": ["type"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["mode", "items"],
            "additionalProperties": false,
            "properties": {
              "mode": { "enum": ["forced_choice", "weighted"] },
              "items": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["node_id", "label"],
                  "additionalProperties": false,
                  "properties": {
                    "node_id": { "$ref": "#/definitions/node_id" },
                    "label": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "criteria": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["label", "weight"],
                  "additionalProperties": false,
                  "properties": {
                    "label": { "type": "string", "minLength": 1 },
                    "weight": { "type": "number", "minimum": 0 }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": { "properties": { "mode": { "const": "weighted" } }, "required": ["mode"] },
                "then": { "required": ["mode", "items", "criteria"] }
              }
            ]
          }
        }
      }
    }
  ]
}
