# OS / editor cruft
.DS_Store

# Dependencies
node_modules/

# Logs
*.log

# Secrets / local env
.env

# Python
.venv/
__pycache__/

# dashes/ holds user project artifacts produced by a dash run. This is an
# open-source, business-agnostic repository, so dash outputs are NOT committed
# here — they belong in the consuming workspace's own private repository.
# Only dashes/.gitkeep is tracked.
dashes/*
!dashes/.gitkeep

# Workspace-local configuration (business-specific overrides stay out of the OSS repo)
dash.config.json

# Local-only trees. The private pilot, agent skill cache, and Playwright
# artifacts stay off the public library.
platform/
.agents/
.playwright-mcp/
